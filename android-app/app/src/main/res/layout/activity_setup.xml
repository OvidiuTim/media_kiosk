<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="32dp" android:gravity="center_horizontal">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Media Kiosk" android:textColor="@color/white" android:textSize="30sp"
            android:textStyle="bold" android:gravity="center" android:layout_marginBottom="24dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Adresa serverului" android:textColor="@color/white" android:labelFor="@id/serverInput" />
        <EditText android:id="@+id/serverInput" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/field_background" android:textColor="@color/white" android:textColorHint="#AAB6C3"
            android:inputType="textUri" android:singleLine="true" android:importantForAutofill="no" android:layout_marginBottom="14dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Cheia dispozitivului" android:textColor="@color/white" android:labelFor="@id/deviceKeyInput" />
        <EditText android:id="@+id/deviceKeyInput" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/field_background" android:textColor="@color/white" android:textColorHint="#AAB6C3"
            android:hint="UUID din panoul Django" android:inputType="textNoSuggestions" android:singleLine="true" android:importantForAutofill="no"
            android:layout_marginBottom="14dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Limită cache" android:textColor="@color/white" />
        <Spinner android:id="@+id/cacheSpinner" android:layout_width="match_parent" android:layout_height="52dp"
            android:entries="@array/cache_limits" android:background="@drawable/field_background" android:layout_marginBottom="14dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Orientare ecran" android:textColor="@color/white" />
        <Spinner android:id="@+id/orientationSpinner" android:layout_width="match_parent" android:layout_height="52dp"
            android:entries="@array/orientations" android:background="@drawable/field_background" android:layout_marginBottom="14dp" />
        <TextView android:id="@+id/pinLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="PIN administrare" android:textColor="@color/white" android:labelFor="@id/pinInput" />
        <EditText android:id="@+id/pinInput" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/field_background" android:textColor="@color/white" android:textColorHint="#AAB6C3"
            android:hint="Minimum 4 cifre" android:inputType="numberPassword" android:singleLine="true" android:importantForAutofill="no"
            android:layout_marginBottom="20dp" />
        <TextView android:id="@+id/testButton" android:layout_width="match_parent" android:layout_height="56dp"
            android:text="Testează conexiunea" android:textSize="17sp" android:textColor="@color/white"
            android:gravity="center" android:clickable="true" android:focusable="true"
            android:background="@drawable/button_background" android:layout_marginBottom="12dp" />
        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/white" android:textSize="16sp" android:visibility="gone"
            android:padding="12dp" android:layout_marginBottom="8dp" />
        <TextView android:id="@+id/saveButton" android:layout_width="match_parent" android:layout_height="56dp"
            android:text="Salvează și pornește" android:textSize="17sp" android:textColor="@color/white"
            android:gravity="center" android:clickable="true" android:focusable="true"
            android:enabled="false" android:background="@drawable/button_background" />
    </LinearLayout>
</ScrollView>
